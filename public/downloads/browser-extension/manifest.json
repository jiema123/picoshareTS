{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.1.9",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "contextMenus",
    "notifications",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/picoshare-48.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/picoshare-16.png",
    "32": "icons/picoshare-32.png",
    "48": "icons/picoshare-48.png",
    "128": "icons/picoshare-128.png"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "icons/picoshare-16.png",
      "32": "icons/picoshare-32.png"
    },
    "default_popup": "popup.html"
  }
}
